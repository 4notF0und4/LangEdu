{
  "name": "@langedu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node database/migrate.mjs",
    "db:seed": "node database/seed.mjs",
    "test:db": "npm run build && node --test database/database.test.mjs"
  },
  "dependencies": {
    "@langedu/contracts": "0.1.0",
    "@nestjs/common": "12.0.2",
    "@nestjs/core": "12.0.2",
    "@nestjs/platform-express": "12.0.2",
    "@vercel/functions": "^3.9.7",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.1",
    "@types/pg": "8.23.1"
  }
}
